{
  "manifest_version": 3,
  "name": "TabSetGo",
  "short_name": "TabSetGo",
  "description": "Ready, set, go: every new tab opens the URL you choose. Self-healing settings and optional cross-device sync.",
  "version": "4.0.0",
  "background": {
    "service_worker" : "js/background.js"
  },
  "options_page":"options.html",
  "chrome_url_overrides": {
    "newtab": "main.html"
  },
  "permissions": ["storage", "favicon"],
  "host_permissions": ["file:///", "file://", "*://*"],
  "optional_permissions": ["tabs", "topSites", "management", "bookmarks"],
  "icons": {
    "200": "images/icon200.png",
    "128": "images/icon128.png",
    "19":"images/icon19.png"
  },
  "incognito": "split",
  "minimum_chrome_version" : "89"
}
